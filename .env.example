# ClaimAssist – environment variable template
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# OpenRouter API key (free account: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision model to use (default: google/gemma-4-31b-it:free)
# Gemma 4 is open-weight and licensed under Apache 2.0.
# Verified free vision models on OpenRouter:
#   google/gemma-4-31b-it:free      (31B dense, recommended)
#   google/gemma-4-26b-a4b-it:free  (26B MoE variant)
# Swap for any OpenRouter-hosted vision model with the same OpenAI-compat API.
MODEL=google/gemma-4-31b-it:free